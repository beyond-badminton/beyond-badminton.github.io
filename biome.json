{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": ["**", "!assets/js/exceljs.min.js", "!assets/js/exceljs.min.js-LICENSE"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 150
	},
